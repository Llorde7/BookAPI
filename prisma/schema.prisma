generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A person who books appointments.
model Customer {
  id           String        @id @default(uuid(7)) @db.Uuid
  email        String        @unique
  name         String
  phone        String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  appointments Appointment[]
  payments     Payment[]
}

// A person (or resource) who can be booked, e.g. a stylist or doctor.
model Provider {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String
  email        String        @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  appointments Appointment[]
}

// Something that can be booked, e.g. "30 min consultation".
model Service {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String
  durationMinutes Int
  priceCents      Int           @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  appointments    Appointment[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED // unpaid hold ran out of time
  BUMPED // unpaid hold given to a customer who paid for the slot
}

// PENDING = unpaid hold on the slot, valid until holdExpiresAt. CONFIRMED = paid.
// Overlap protection lives in the database, not here: see the
// "appointment_no_overlap" exclusion constraint in the migrations. It covers
// PENDING, CONFIRMED, COMPLETED and NO_SHOW; the other statuses free the slot.
model Appointment {
  id            String            @id @default(uuid(7)) @db.Uuid
  providerId    String            @db.Uuid
  customerId    String            @db.Uuid
  serviceId     String            @db.Uuid
  startsAt      DateTime          @db.Timestamptz(6)
  endsAt        DateTime          @db.Timestamptz(6)
  status        AppointmentStatus @default(PENDING)
  // Only set while PENDING. After this time the hold is released (EXPIRED).
  holdExpiresAt DateTime?         @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([providerId, startsAt])
  @@index([customerId, startsAt])
}

enum PaymentStatus {
  AUTHORIZED // funds reserved on the card, not charged yet
  CAPTURED // charged
  VOIDED // reservation released, customer never charged
  FAILED // capture failed after the booking was confirmed; booking was cancelled
}

// Authorize-then-capture: the card is authorized first, the booking is confirmed
// second, and the money is captured only if the booking succeeded.
model Payment {
  id            String        @id @default(uuid(7)) @db.Uuid
  customerId    String        @db.Uuid
  // Linked in the same transaction that confirms the booking.
  appointmentId String?       @db.Uuid
  amountCents   Int
  status        PaymentStatus @default(AUTHORIZED)
  // The payment provider's authorization id.
  providerRef   String        @unique
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([status, createdAt])
}
