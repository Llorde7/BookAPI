PORT=3000
POSTGRES_USER=bookapi
POSTGRES_PASSWORD=bookapi
POSTGRES_DB=bookapi
POSTGRES_PORT=5432
DATABASE_URL=postgres://bookapi:bookapi@localhost:5432/bookapi
HOLD_MINUTES=1440
# Signs access tokens. Generate your own: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Access token lifetime in seconds (default 900 = 15 minutes, max 3600)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (default 30, max 90)
REFRESH_TOKEN_TTL_DAYS=30
# Tests wipe their database, so its name must contain "test" (see README)
# TEST_DATABASE_URL=postgres://bookapi:bookapi@localhost:5432/bookapi_test
